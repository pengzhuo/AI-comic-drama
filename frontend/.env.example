VITE_API_URL=http://localhost:8780

# Auth mode is decided at runtime by GET /api/v1/config. VITE_EDITION=ce is only
# a CE release fallback if /api/v1/config cannot be loaded.
# VITE_EDITION=ce

# Infinite-canvas (Freezone / 虾画) app origin. Freezone is a separate app on its
# own domain. PRODUCTION MUST SET THIS — without it the SPA falls back to
# `<current-host>:5175` (dev only). Used by src/lib/freezone-url.ts.
# VITE_FREEZONE_URL=https://freezone.dramaclaw.ai
# Local dev with image-freezone's default Vite port:
# VITE_FREEZONE_URL=http://localhost:5176

# Multi-region cluster support (optional). Unset → mode="none" → today's app unchanged.
# VITE_CLUSTER_MODE=multi-region
# VITE_CLUSTER_REGIONS_URL=/cluster-config.json

# Instance-level UI hides (optional). Build-time: they are baked into the bundle,
# so a rebuild is required after changing them. Unset = upstream default.
# VITE_HIDE_PIKO_ENTRY=1          # drop the status-bar Piko entry
# VITE_HIDE_NOTIFICATION_CENTER=1 # drop the notification center (incl. the login bell)
# VITE_HIDE_RELEASE_POPUP=1       # drop the on-entry release popup
# VITE_HIDE_OFFICIAL_CHANNELS=1   # keep the local NewAPI channel only
# VITE_HIDE_MODEL_GUIDE=1         # drop the model-configuration guide link
# VITE_HIDE_GITHUB_STARS=1        # never call the GitHub API for star counts
# Announcement source. Unset → the upstream OSS announcements.json (network);
# point it at a local file to stay offline:
# VITE_LOGIN_ANNOUNCEMENTS_URL=/announcements.empty.json
#
# Dual-entry instance (optional, build-time). Sets the internal app's own entry
# path and hands the root URL to the customer studio: `/` → `/studio`, the
# internal pages (and the project list) hang off e.g. `/console`.
# Unset → the internal app keeps `/` as its home. Path must match the route file
# `src/routes/_app/console.tsx`. Path partitioning only — not access control.
# VITE_INTERNAL_ENTRY_PATH=/console
#
# For this deployment these live in `.env.ce.local` (git-ignored, loaded by
# `npm run build:ce` only) — see docs/agents/web-hotpatch-deploy.md.
